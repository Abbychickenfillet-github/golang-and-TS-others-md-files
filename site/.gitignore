# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 由 scripts/sync-assets.mjs 在 build 前從根目錄 assets/ 複製而來，不進版控
/public/assets/

# 由 scripts/site-report.mjs 在 build 前產生的整站警告報告，不進版控
/.build-report.json

# 由 scripts/verify.mjs 在建置後產生的完整驗證報告（壞連結與缺少的錨點全部清單），不進版控
/.verify-report.json

# 建置測試（tests/build-fixture.test.ts）的輸出資料夾，不進版控
/out-fixture/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
